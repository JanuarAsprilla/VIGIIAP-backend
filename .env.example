# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Base de datos (PostgreSQL + PostGIS — Supabase o servidor propio) ────────
# Funciona igual contra Supabase que contra un Postgres+PostGIS local/on-premise.
# Para servidor propio (sin Supabase): DB_HOST=localhost (o el host del server),
# DB_SSL=false salvo que Postgres tenga TLS configurado.
DB_HOST=db.xxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=true
# En producción con Supabase dejar en true. false en servidor propio sin TLS
# configurado en Postgres, o en dev local.
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── JWT ─────────────────────────────────────────────────────────────────────
# CRÍTICO: Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El valor de ejemplo cumple la validación de longitud pero es PREDECIBLE — reemplazar obligatoriamente.
JWT_SECRET=REPLACE_WITH_REAL_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ─── Almacenamiento de archivos (compatible S3: Cloudflare R2 o MinIO propio) ─
# S3_ENDPOINT: dejar SIN definir para usar Cloudflare R2 (comportamiento por
# defecto). Definirla para apuntar a MinIO auto-hospedado u otro S3-compatible,
# ej: http://localhost:9000 (dev) o https://storage.vigiiap.iiap.gov.co (servidor propio).
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE: MinIO y la mayoría de self-hosted lo requieren en 'true'.
# Dejar sin definir (false) para Cloudflare R2.
# S3_FORCE_PATH_STYLE=true
# S3_REGION: MinIO ignora el valor pero el SDK exige uno. 'auto' funciona para
# R2 y para MinIO por igual — no suele hacer falta cambiarlo.
# S3_REGION=auto

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# Bucket PRIVADO — PDFs y documentos
# Cloudflare: Public Access Disabled. MinIO: bucket sin política anonymous.
R2_BUCKET_NAME=vigiiap-files
R2_PUBLIC_URL=https://files.vigiiap.iiap.gov.co

# Bucket PÚBLICO — thumbnails, imágenes, fotos
# Cloudflare: Public Access Enabled. MinIO: `mc anonymous set download local/<bucket>`.
R2_PUBLIC_BUCKET_NAME=vigiiap-files-public
R2_PUBLIC_BUCKET_URL=https://media.vigiiap.iiap.gov.co

# ─── CORS ────────────────────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por coma (sin espacios). Este es el
# piso fijo — el super_admin puede agregar orígenes EXTRA desde el panel
# (clave cors_extra_origins en `configuracion`) sin redesplegar, pero nunca
# puede quitar los de aquí. Incluir el dominio del frontend en Render Y el
# dominio de producción final.
# Ejemplo Render: https://vigiiap.onrender.com
# Ejemplo producción: https://vigiiap.iiap.gov.co
CORS_ORIGIN=http://localhost:5173,https://vigiiap.onrender.com,https://vigiiap.iiap.gov.co

# ─── Rate limiting ───────────────────────────────────────────────────────────
# RATE_LIMIT_MAX también se puede ajustar desde el panel (clave rate_limit_max)
# sin redeploy — la clave de BD tiene prioridad si está guardada. WINDOW_MS
# NO es dinámico: express-rate-limit lo fija al crear el middleware.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# El super_admin puede configurar todo esto desde el panel (Configuración →
# Correo) sin tocar estas variables — útil porque el instituto cambia de
# proveedor de correo de vez en cuando. Si las tres (HOST/USER/PASS) están
# definidas aquí, tienen prioridad sobre el panel — vía de escape operativa.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=notificaciones@iiap.gov.co
MAIL_PASS=your_app_password
MAIL_FROM_NAME=VIGIIAP — IIAP

# ─── Frontend URL (para links en emails) ─────────────────────────────────────
FRONTEND_URL=https://vigiiap.iiap.gov.co

# ─── Redis (opcional) ────────────────────────────────────────────────────────
# Si no se configura: cache desactivado y emails van en modo síncrono sin retry.
# En Render: usar Upstash Redis (capa gratuita) → copiar la URL de conexión aquí.
REDIS_URL=redis://localhost:6379


# ─── 2FA / TOTP ──────────────────────────────────────────────────────────────
# Requerido si 2FA está habilitado. Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOTP_ENCRYPTION_KEY=

# ─── Seeds / Scripts de inicialización (solo en setup inicial) ───────────────
# Requerido para: node scripts/create-admin.js
ADMIN_SEED_PASSWORD=
# Opcional (default: admin@iiap.gov.co): 
# ADMIN_SEED_EMAIL=

# Requerido para: node scripts/create-superadmin.js
# SUPERADMIN_SEED_PASSWORD=

# ─── Notificaciones admin ────────────────────────────────────────────────────
# Fallback de email si no hay admin_sig activo en BD. Separados por coma.
# También editable desde el panel (clave admin_email_fallback), que tiene
# prioridad sobre esta variable si está guardada.
# ADMIN_EMAIL=admin@iiap.gov.co
